# Copy to .env.local and adjust. Vite only exposes variables that start with VITE_.

# Base URL of the SmartWaste AI FastAPI backend (no trailing slash).
# Default when unset: http://localhost:8000/api
VITE_API_URL=http://localhost:8000/api

# Alternatives:
#   VITE_API_URL=http://127.0.0.1:8000/api   # skips the IPv6 attempt Windows makes for "localhost"
#   VITE_API_URL=/api                        # same-origin via the Vite dev proxy (vite.config.js), no CORS
